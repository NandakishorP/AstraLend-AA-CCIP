# Base URL of the AstraLend backend (Fastify).
# The backend defaults to 3001 so Next.js can keep 3000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# RPC endpoints for the two chains.
#
# Both default to the local Anvil pair (see src/lib/chains.ts). Leaving
# NEXT_PUBLIC_ARB_RPC_URL unset used to fall through to a public Arbitrum
# endpoint, which accepted the transaction and then never returned a receipt —
# the repay dialog hung on "Confirming" while the write had already landed
# locally. Set both explicitly.
NEXT_PUBLIC_ETH_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_ARB_RPC_URL=http://127.0.0.1:8546
