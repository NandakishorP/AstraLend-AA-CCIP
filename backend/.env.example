# ─── Chain RPC endpoints ───────────────────────────────────────────────────────
# Local Anvil pair (see tooling/start-demo.sh), or your own testnet URLs.
ETH_SEPOLIA_RPC_URL=http://localhost:8545
ARB_SEPOLIA_RPC_URL=http://127.0.0.1:8546

# ─── Signer ────────────────────────────────────────────────────────────────────
# Anvil's account #9. This key is published in the Foundry documentation and
# holds nothing — it is a placeholder, not a secret.
#
# Deliberately NOT account #0: the demo imports account #0 into MetaMask, and if
# the backend signed with the same address its faucet and keeper transactions
# would consume nonces out from under the wallet, failing the user's sends with
# a nonce conflict.
PRIVATE_KEY=0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6

# ─── Active chain ──────────────────────────────────────────────────────────────
# "eth" (hub) or "arb" (satellite)
ACTIVE_CHAIN=eth

# ─── Deployed addresses ────────────────────────────────────────────────────────
# Written by tooling/deploy-local.mjs into tooling/deployment.env — copy them
# across, or point at your own deployment. The lending pool address must be the
# TransparentUpgradeableProxy, not the implementation.
ETH_LENDING_POOL_ADDRESS=
ETH_VAULT_ADDRESS=
ETH_STABLE_COIN_ADDRESS=

ARB_LENDING_POOL_ADDRESS=
ARB_VAULT_ADDRESS=
ARB_STABLE_COIN_ADDRESS=

# ─── CCIP routers (indexed for cross-chain message tracking) ──────────────────
ETH_CCIP_ROUTER_ADDRESS=
ARB_CCIP_ROUTER_ADDRESS=

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Persistence + indexer ────────────────────────────────────────────────────
DATABASE_PATH=./data/astralend.db
INDEXER_ENABLED=true
INDEXER_POLL_MS=2000
INDEXER_BATCH_BLOCKS=2000
SNAPSHOT_INTERVAL_MS=30000
