# Compiler files
cache/
out/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Dotenv file
.env

# macOS Finder metadata
.DS_Store

# Local Anvil hub chain — same reasoning as the 31337 rule above.
/broadcast/*/424242/

# Timestamped broadcast runs. run-latest.json is enough to keep.
/broadcast/**/run-[0-9]*.json
